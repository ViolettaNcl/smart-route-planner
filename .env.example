# Скопируйте в .env (уже в .gitignore — ключи никогда не попадут в git)
# рядом с docker-compose.yml. Всё здесь необязательно — без ключей
# приложение работает полностью, просто AI-ассистент поездки использует
# офлайн rule-based fallback вместо настоящего вызова LLM (см.
# src/AI/TripAssistantService.php).

# Порт на хосте, с которого будет доступен сайт (внутри контейнера — всегда 80).
PORT=8080

# --- Public URL / geocoding / routing ---
# Used for canonical and Open Graph metadata.
APP_PUBLIC_URL=https://smart-route-planner.example.com

# Public Nominatim is used only for explicit geocoding on form submission.
# It does NOT permit client-side autocomplete. To enable explicit search UI,
# point this to an instance/provider whose terms allow that usage.
NOMINATIM_SEARCH_ENDPOINT=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=smart-route-planner/1.0 (contact@example.com)

# Ordered OSRM-compatible providers. The application caches successful road
# routes and tries the next provider only when the previous one is unavailable.
# For production traffic, put a managed/self-hosted endpoint first.
OSRM_ROUTE_ENDPOINTS=https://router.project-osrm.org/route/v1/driving,https://routing.openstreetmap.de/routed-car/route/v1/driving
OSRM_ALTERNATIVES=2
OSRM_CACHE_TTL_SECONDS=21600
OSRM_STALE_TTL_SECONDS=604800
ROUTING_USER_AGENT=smart-route-planner/1.0 (contact@example.com)

# --- AI-ассистент поездки ---
# На Vercel ключ не нужен: приложение автоматически использует
# VERCEL_OIDC_TOKEN для AI Gateway. Для Docker/VPS можно создать Gateway key.
AI_GATEWAY_API_KEY=
AI_MODEL_GATEWAY=openai/gpt-5-mini

# Резервные прямые провайдеры (необязательно):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Опционально — переопределить модель по умолчанию:
AI_MODEL_ANTHROPIC=
AI_MODEL_OPENAI=
