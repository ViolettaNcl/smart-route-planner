# --- Секреты ---
.env
config.local.php

# --- Зависимости (в проекте нет обязательных runtime-пакетов, но composer
# может создать эту папку локально) ---
/vendor/
/node_modules/
/test-results/
/playwright-report/
/blob-report/

# --- Рантайм-данные: кэш геокодера, состояние rate limiter'а, статистика
# A/B-теста и дообученные веса модели. Не тащим в git — пересоздаются сами
# при первом запуске (см. FileCache::__construct / RateLimiter::__construct) ---
/var/geocache/*
/var/ratelimit/*
/var/ab_stats.json
/var/app.log
/var/ml_feedback.ndjson
/var/feedback_archive/
/var/mlp_weights.json
/var/model_versions/
!/var/geocache/.gitkeep
!/var/ratelimit/.gitkeep

# --- Кэш инструментов статического анализа ---
/var/phpstan-cache/
.php-cs-fixer.cache

# --- IDE / ОС-мусор ---
.idea/
.vscode/
*.DS_Store
Thumbs.db

# --- Composer lock — держите закоммиченным, если хотите воспроизводимые
# сборки в CI; раскомментируйте, если сознательно не хотите его версионировать
# composer.lock
