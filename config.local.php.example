<?php

/**
 * Шаблон локального конфига для ключей API.
 *
 * Скопируйте этот файл в config.local.php (это имя уже в .gitignore — ключи
 * никогда не попадут в git) и раскомментируйте нужные строки.
 *
 * Ничего из этого не обязательно: без ключей приложение работает полностью,
 * просто AI-ассистент поездки (App\AI\TripAssistantService) использует
 * офлайн rule-based fallback вместо настоящего вызова LLM.
 */

// --- AI-ассистент поездки: достаточно одного ключа ---

// Vercel AI Gateway (рекомендуется для локальной разработки/VPS):
// putenv('AI_GATEWAY_API_KEY=...');

// Резервные прямые провайдеры:
// putenv('ANTHROPIC_API_KEY=sk-ant-...');
// putenv('OPENAI_API_KEY=sk-...');

// Опционально — переопределить модель по умолчанию:
// putenv('AI_MODEL_GATEWAY=openai/gpt-5-mini');
// putenv('AI_MODEL_ANTHROPIC=claude-haiku-4-5-20251001');
// putenv('AI_MODEL_OPENAI=gpt-5-mini');

// --- Маршрутизация и геокодирование (необязательно) ---
// Несколько OSRM-compatible endpoint перечисляются по приоритету:
// putenv('OSRM_ROUTE_ENDPOINTS=https://routing.example.com/route/v1/driving,https://router.project-osrm.org/route/v1/driving');
// putenv('ROUTING_USER_AGENT=smart-route-planner/2.0 (contact@example.com)');
// putenv('NOMINATIM_SEARCH_ENDPOINT=https://nominatim.example.com/search');
